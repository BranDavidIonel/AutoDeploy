APP_NAME=AutoDeploy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8077

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# A deploy can run up to an hour: the queue must not hand it to another worker before that.
DB_QUEUE_RETRY_AFTER=4000

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AutoDeploy (see config/autodeploy.php)
# Bash for servers of type "This machine"; empty = auto (/bin/bash on Linux, Git Bash on Windows)
AUTODEPLOY_LOCAL_SHELL=
AUTODEPLOY_CONNECT_TIMEOUT=20
AUTODEPLOY_COMMAND_TIMEOUT=3600
AUTODEPLOY_LOCAL_BUILD_TIMEOUT=1800
AUTODEPLOY_MAX_UPLOAD_MB=200
# Start a queue worker by itself when a deployment is queued and none runs.
# true: handy on Windows / a PC (start-autodeploy.bat, Apache without a worker).
# false: on a Linux server where systemd or Supervisor keeps "php artisan queue:work" running
# (a worker started from PHP-FPM runs as its user and ends when PHP-FPM restarts).
AUTODEPLOY_AUTO_WORKER=true
# PHP command line binary for that worker; empty = auto-detect (e.g. /usr/bin/php8.4 next to PHP-FPM 8.4)
AUTODEPLOY_PHP_BINARY=

# Admin account made by "php artisan db:seed" (real values only here, never in git).
# Empty password = a random one is made once and printed by the seeder.
AUTODEPLOY_ADMIN_EMAIL=admin@example.com
AUTODEPLOY_ADMIN_PASSWORD=
