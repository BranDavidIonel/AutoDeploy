# AutoDeploy on a server – production .env, created once by deploy/server/install.sh (it never
# overwrites it). The config is cached: after a change run  sudo {{SITE_NAME}}-artisan optimize
# Keep this file private: APP_KEY decrypts the server secrets saved in the database.

APP_NAME=AutoDeploy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL={{APP_URL}}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# database/database.sqlite (set DB_DATABASE only for another path)
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# The Apache site serves HTTPS only.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must be longer than the longest deploy (the worker runs with --timeout=3600).
DB_QUEUE_RETRY_AFTER=4000

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# AutoDeploy (see config/autodeploy.php)
# Bash for servers of type "This machine"; empty = /bin/bash
AUTODEPLOY_LOCAL_SHELL=
AUTODEPLOY_CONNECT_TIMEOUT=20
AUTODEPLOY_COMMAND_TIMEOUT=3600
AUTODEPLOY_LOCAL_BUILD_TIMEOUT=1800
# Largest build archive uploaded from the browser; install.sh sets upload_max_filesize /
# post_max_size of the PHP-FPM pool from it (run install.sh again after changing it).
AUTODEPLOY_MAX_UPLOAD_MB=200
# false: the systemd service {{WORKER_UNIT}} keeps a queue worker running, AutoDeploy must not start another one.
AUTODEPLOY_AUTO_WORKER={{AUTO_WORKER}}
# PHP command line binary (used only by the automatic worker)
AUTODEPLOY_PHP_BINARY={{PHP_BIN}}

# The admin account made by the database seeder. The password is not kept here: give it once to the
# installer (AUTODEPLOY_ADMIN_PASSWORD=... in its environment) or let it print a random one, then
# change it in "My account".
AUTODEPLOY_ADMIN_EMAIL={{ADMIN_EMAIL}}
AUTODEPLOY_ADMIN_PASSWORD=
